# Environment variables template for ServZest

# App Settings
PORT=4000
NODE_ENV=development
APP_NAME=ServZest
CLIENT_URL=http://localhost:3001

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/servzest?schema=public

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=servzest_session
SESSION_TTL_SECONDS=604800
TRUST_PROXY=0

# Production OTP (mock provider is development-only)
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Increment when Terms/Privacy wording changes and consent must be refreshed
LEGAL_VERSION=2026-09-21
BOOKING_LOCATION_RETENTION_DAYS=90
WORKER_LOCATION_RETENTION_HOURS=24

# Local development fixtures only. Never enable on production.
SEED_DEMO_DATA=false
ADMIN_PHONE=
ADMIN_NAME=ServZest Administrator
ADMIN_PHONE_ALLOWLIST=

# Separate encryption key for KYC identity values (required in production)
KYC_ENCRYPTION_KEY=replace-with-a-different-32-character-random-key

# Default Location (Connaught Place, New Delhi)
DEFAULT_CITY=New Delhi
DEFAULT_LAT=28.6139
DEFAULT_LNG=77.2090
