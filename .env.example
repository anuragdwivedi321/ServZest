# Environment variables template for QuickKaam

# App Settings
PORT=4000
NODE_ENV=development
APP_NAME=QuickKaam
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/quickkaam?schema=public

# Authentication
JWT_SECRET=super-secret-jwt-key-for-quickkaam-mvp-change-in-prod
JWT_EXPIRES_IN=7d

# Default Location (Connaught Place, New Delhi)
DEFAULT_CITY=New Delhi
DEFAULT_LAT=28.6139
DEFAULT_LNG=77.2090
