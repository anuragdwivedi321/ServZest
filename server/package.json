{
  "name": "servzest-server",
  "version": "1.0.0",
  "description": "ServZest MVP Backend - On-demand Home Services Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "simulate:worker": "tsx scripts/worker-simulator.ts",
    "test": "jest --detectOpenHandles",
    "verify:backend": "node scripts/verify-backend.cjs",
    "verify:launch-features": "node scripts/launch-features-smoke.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.6",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "socket.io-client": "^4.7.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
